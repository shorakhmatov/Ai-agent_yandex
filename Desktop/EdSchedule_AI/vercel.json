{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python manage.py collectstatic --noinput",
  "devCommand": "python manage.py runserver",
  "installCommand": "pip install -r requirements.txt && cd frontend && npm ci",
  "framework": "django",
  "regions": ["iad1"],
  "functions": {
    "config/wsgi.py": {
      "runtime": "vercel-python@3.12",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "config/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "config/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "config/wsgi.py"
    },
    {
      "src": "/(assets/.*)",
      "dest": "frontend/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ]
}